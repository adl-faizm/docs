{
  "$schema": "https://mintlify.com/docs.json",
  "name": "XLSMART Design System",
  "theme": "mint",
  "colors": {
    "primary": "#1E22AA",
    "light": "#ffffff",
    "dark": "#4fa1ab"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Foundation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "contributing"
            ]
          },
          {
            "group": "Foundation",
            "pages": [
              "foundation/untitled-page",
              "foundation/typography",
              "foundation/spacing",
              "foundation/elevation",
              "foundation/motion"
            ]
          },
          {
            "group": "Guidelines",
            "pages": [
              "guidelines/accessibility",
              "guidelines/responsive",
              "guidelines/iconography",
              "guidelines/content"
            ]
          }
        ]
      },
      {
        "tab": "Components",
        "groups": [
          {
            "group": "Layout",
            "pages": [
              "components/grid",
              "components/stack",
              "components/divider"
            ]
          },
          {
            "group": "Core UI",
            "pages": [
              "components/button",
              "components/icon-button",
              "components/link",
              "components/badge",
              "components/tag"
            ]
          },
          {
            "group": "Forms",
            "pages": [
              "components/input",
              "components/select",
              "components/checkbox",
              "components/radio",
              "components/toggle"
            ]
          },
          {
            "group": "Feedback",
            "pages": [
              "components/alert",
              "components/toast",
              "components/modal",
              "components/tooltip"
            ]
          },
          {
            "group": "Navigation",
            "pages": [
              "components/tabs",
              "components/breadcrumb",
              "components/pagination"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "For Designers",
            "pages": [
              "resources/figma",
              "resources/design-principles"
            ]
          },
          {
            "group": "For Developers",
            "pages": [
              "resources/installation",
              "resources/theming",
              "resources/changelog"
            ]
          }
        ]
      }
    ]
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "logo": {
    "light": "/images/Logo-Light.svg",
    "dark": "/images/Logo-Dark.svg"
  },
  "thumbnails": {
    "appearance": "light"
  }
}
